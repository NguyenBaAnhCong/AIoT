# Sao chép file này thành .env rồi chỉnh sửa:  copy .env.example .env
# KHÔNG đưa file .env lên GitHub (đã có trong .gitignore).

# --- PostgreSQL (docker) ---
POSTGRES_USER=biochar
POSTGRES_PASSWORD=biochar_dev_pw
POSTGRES_DB=edge_aiot_biochar
# Nếu máy bạn đã cài PostgreSQL riêng và bị chiếm cổng 5432, đổi sang 5433 (và sửa DATABASE_URL bên dưới)
DB_PORT=5432
SEED_DEMO=true            # true: nạp dữ liệu demo lần đầu; false: database trống

# --- Backend ---
NODE_ENV=development
BACKEND_PORT=4000
# Khi chạy backend ngoài docker (npm run dev), dùng localhost:
DATABASE_URL=postgres://biochar:biochar_dev_pw@localhost:5432/edge_aiot_biochar
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# --- Ngoài production: đặt mật khẩu mặc định cho user demo (admin, researcher01, labtech01) ---
SEED_DEV_PASSWORDS=true
DEV_DEFAULT_PASSWORD=Biochar@2026

# --- Docker: cổng mở ra máy ---
FRONTEND_PORT=8080
